# Patches reach the working tree byte for byte: vcpkg applies them with `git apply`, which rejects a CRLF patch
# against LF sources (plain `patch` accepts it, so the failure is easy to miss).
*.patch -text
*.diff  -text

# Shell scripts are LF everywhere (bash outside MSYS2 fails on CR); batch files are CRLF everywhere (cmd.exe
# mis-parses labels and ^-continuations with LF). Launchers are copied onto the drive as they are checked out.
*.sh  text eol=lf
*.bat text eol=crlf

# The controlled triplets are hash-checked by step 3, so git must not convert them.
vcpkg_overlays/triplets/*.cmake  -text
vcpkg_overlays/triplets/*.sha256 -text
