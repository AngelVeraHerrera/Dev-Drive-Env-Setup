{
    "environment": {
        "dev_drive_label": "DEV_DEGORAS_SLR_T1",
        "dev_drive_letter": "R",
        "dev_env_name": "DegorasSLR",
        "vhd_root": "C:/DevDrives",
        "vhd_size_gb": 50,
        "use_dev_drive": false,
        "force_diskpart": true,
        "vhd_fixed": true,
        "custom_variables": {
            "CUDA_PATH": "C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v13.3/bin",
            "GST_PLUGIN_PATH": "${VCPKG_ROOT}/installed/${VCPKG_DEFAULT_TRIPLET}/plugins/gstreamer",
            "GST_REGISTRY": "${DEVDRIVE_LETTER}/logs/gstreamer/registry/registry.x86_64.bin",
            "GST_DEBUG_DUMP_DOT_DIR": "${DEVDRIVE_LETTER}/logs/gstreamer/dot",
            "GST_DEBUG_FILE": "${DEVDRIVE_LETTER}/logs/gstreamer/gst-debug.log",
            "GST_DEBUG": "2"
        },
        "custom_path_entries": ["${CUDA_PATH}"],
        "custom_folders": ["logs/gstreamer/dot", "logs/gstreamer/registry", "workspace_vcpkg_patches"],
        "install_testing_material": true,
        "install_installation_material": true,
        "verification": {
            "check_packages": true,
            "check_dll_load": true,
            "check_tools": [
                "vcpkg",
                "gst-inspect-1.0",
                "gst-launch-1.0",
                "gst-discoverer-1.0",
                "ffmpeg",
                "ffprobe",
                "curl",
                "pkgconf"
            ],
            "check_commands": [
                { "run": "gst-inspect-1.0 --version", "expect": "GStreamer" },
                { "run": "ffmpeg -hide_banner -version", "expect": "ffmpeg version" },
                { "run": "curl --version", "expect": "OpenSSL" },
                { "run": "pkgconf --version", "expect": "" }
            ],
            "check_gstreamer_elements": [
                "videotestsrc",
                "audiotestsrc",
                "decodebin",
                "playbin",
                "matroskademux",
                "x264enc",
                "x265enc",
                "openh264enc",
                "libde265dec",
                "d3d11h264dec",
                "d3d11h265dec",
                "d3d11videosink",
                "d3d11screencapturesrc",
                "nvh264enc",
                "nvh264dec",
                "mfh264enc",
                "rtph264pay",
                "rtph265pay",
                "rtpjitterbuffer",
                "udpsink",
                "udpsrc",
                "srtsink",
                "hlssink2",
                "fpsdisplaysink",
                "svtav1enc",
                "avdec_h264",
                "avenc_aac",
                "glupload",
                "glimagesink"
            ]
        },
        "append_windows_system_path": true,
        "proxy_url": ""
    },
    "msys2": {
        "source": { "url": "https://repo.msys2.org/distrib/msys2-x86_64-latest.sfx.exe", "sha256": "" },
        "target": { "profile": "ucrt", "arch": "x86_64", "base_url": "https://repo.msys2.org" },
        "packages": [
            { "name": "ninja", "mode": "pinned", "version": "1.13.2-1" },
            { "name": "gdb", "mode": "pinned", "version": "17.2-1" },
            { "name": "gcc", "mode": "pinned", "version": "16.2.0-3" },
            { "name": "gcc-libs", "mode": "pinned", "version": "16.2.0-3" },
            { "name": "gcc-objc", "mode": "pinned", "version": "16.2.0-3" },
            { "name": "make", "mode": "pinned", "version": "4.4.1-3" },
            { "name": "make", "mode": "pinned", "version": "4.4.1-3", "repo": "msys" },
            { "name": "diffutils", "mode": "pinned", "version": "3.12-1" },
            { "name": "lld", "mode": "pinned", "version": "22.1.8-2" },
            { "name": "ripgrep", "mode": "pinned", "version": "15.2.0-1" },
            { "name": "curl", "mode": "pinned", "version": "8.21.0-2" },
            { "name": "doxygen", "mode": "pinned", "version": "1.18.0-1" },
            { "name": "7zip", "mode": "pinned", "version": "26.02-1" },
            { "name": "ntldd", "mode": "pinned", "version": "r19.7fb9365-4" },
            { "name": "cmake", "mode": "pinned", "version": "4.4.2-2" },
            { "name": "qt-creator", "mode": "pinned", "version": "20.0.0-1" }
        ]
    },
    "vcpkg": {
        "source": {
            "repository_url": "https://github.com/microsoft/vcpkg.git",
            "baseline_mode": "fixed",
            "baseline_commit": "06d00ffa491e4668627728f14b891d22c6fea146"
        },
        "target": { "triplet": "x64-mingw-ucrt-dynamic-release" },
        "packages": [
            { "name": "fmt" },
            { "name": "pkgconf" },
            { "name": "nlohmann-json" },
            { "name": "openssl" },
            { "name": "zlib" },
            { "name": "curl", "features": ["openssl", "ssh", "ssl", "tool", "brotli", "c-ares", "zstd"] },
            { "name": "spdlog" },
            { "name": "libbson" },
            { "name": "mongo-c-driver", "features": ["openssl"] },
            { "name": "mongo-cxx-driver" },
            { "name": "xerces-c" },
            { "name": "sdl2" },
            { "name": "zeromq", "features": ["curve", "draft", "sodium"] },
            { "name": "cppzmq" },
            { "name": "glib" },
            { "name": "grpc", "features": ["codegen"] },
            {
                "name": "ffmpeg",
                "features": [
                    "avcodec",
                    "avformat",
                    "avfilter",
                    "avdevice",
                    "swresample",
                    "swscale",
                    "ffmpeg",
                    "ffprobe",
                    "ffplay",
                    "x264",
                    "x265",
                    "aom",
                    "dav1d",
                    "svt-av1",
                    "vpx",
                    "mp3lame",
                    "opus",
                    "vorbis",
                    "speex",
                    "openjpeg",
                    "webp",
                    "zlib",
                    "bzip2",
                    "lzma",
                    "xml2",
                    "soxr"
                ]
            },
            {
                "name": "gstreamer",
                "features": [
                    "nvcodec",
                    "plugins-base",
                    "plugins-good",
                    "plugins-bad",
                    "gl",
                    "gl-graphene",
                    "plugins-ugly",
                    "gpl",
                    "openh264",
                    "x264",
                    "x265",
                    "libde265",
                    "opus-base",
                    "opus-bad",
                    "vorbis",
                    "flac",
                    "srt",
                    "hls",
                    "jpeg",
                    "png",
                    "webp",
                    "openjpeg",
                    "libav"
                ]
            },
            { "name": "gst-rtsp-server" },
            {
                "name": "qtbase",
                "features": [
                    "gui",
                    "thread",
                    "widgets",
                    "network",
                    "opengl",
                    "testlib",
                    "openssl",
                    "freetype",
                    "harfbuzz",
                    "png",
                    "jpeg",
                    "zstd",
                    "concurrent",
                    "windeployqt"
                ]
            },
            { "name": "qt5compat" },
            { "name": "qtdeclarative" },
            {
                "name": "opencv4",
                "features": ["tbb", "qt", "gstreamer", "opengl", "contrib", "openjpeg", "jpeg", "png", "tiff", "webp"]
            },
            { "name": "qtmultimedia", "features": ["ffmpeg", "widgets", "qml"] },
            { "name": "qtcharts" },
            { "name": "qtimageformats" },
            { "name": "qt-advanced-docking-system" }
        ]
    }
}
