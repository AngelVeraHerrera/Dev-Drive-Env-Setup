diff --git a/src/cpp/CMakeLists.txt b/src/cpp/CMakeLists.txt
index 2a27163..18361d9 100644
--- a/src/cpp/CMakeLists.txt
+++ b/src/cpp/CMakeLists.txt
@@ -32,9 +32,19 @@ set(${PROJECT_NAME}_source_files
     exceptions/Exception.cpp
     exceptions/LockedExternalAccessException.cpp
     exceptions/NotEnoughMemoryException.cpp
-    FastCdr.rc
     )
 
+# A resource script inside a STATIC library is meaningless, and windres does not merely ignore it -- it fails. With
+# BUILD_SHARED_LIBS=OFF the guarded body of FastCdr.rc compiles to nothing and windres stops with
+#
+#     windres.exe: no resources
+#
+# which kills the build before a single object is produced. Added only for a shared build, which is the only place a
+# resource can do anything at all.
+if(WIN32 AND BUILD_SHARED_LIBS)
+    list(APPEND ${PROJECT_NAME}_source_files FastCdr.rc)
+endif()
+
 configure_file(${PROJECT_SOURCE_DIR}/include/${PROJECT_NAME}/config.h.in
     ${PROJECT_BINARY_DIR}/include/${PROJECT_NAME}/config.h)
 
