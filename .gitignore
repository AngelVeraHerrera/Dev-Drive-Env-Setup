# Folders.
*build*/
*product*/
*todo*/
*install*/
# ...except the notes that must travel with the generator. The pattern above is for install_logs/;
# installation/ is hand-written knowledge about what an environment needed, which is the opposite of a log.
!GenericDevDriveEnvSetup/installation/
!GenericDevDriveEnvSetup/installation/**
*deploy*/

# Cfg files
generic_dev_drive_env-cfg.json

# Logs
*.log

# Temporal
*.TMP
*.tmp
*.autosave
*.zst

# Python
*.idea

# Docs.
*Docs*/
*docs*/

# User config
CMakeLists.txt.user
.vscode/*
.qtcreator/*

# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Orig
*.orig
