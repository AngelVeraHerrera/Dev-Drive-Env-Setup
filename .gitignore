# Folders.
*build*/
*product*/
*todo*/
*install*/
# ...except the notes that must travel with the generator. The pattern above is for install_logs/;
# installation/ is hand-written knowledge about what an environment needed, which is the opposite of a log.
!installation/
!installation/**
*deploy*/

# Cfg files. The pattern covers the working copy AND the hand-made backups beside it -- same
# secretless-but-machine-specific content, and "drivenv-cfg - copia.json" is exactly what
# Windows names one. The two documentation copies are named back in.
drivenv-cfg*.json
!drivenv-cfg_example.json
!drivenv-cfg_full-reference.json

__pycache__/

# Logs
*.log

# Temporal
*.TMP
*.tmp
*.autosave
*.zst

# Python
*.idea

# Docs.
*Docs*/
*docs*/

# User config
CMakeLists.txt.user
# Per-developer CMake presets: they hard-code a drive letter and a triplet, so a committed one is wrong
# for everybody except whoever committed it.
CMakeUserPresets.json
.vscode/*
.qtcreator/*

# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Orig
*.orig
